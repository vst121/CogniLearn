# ==========================================
# CogniLearn AI Environment Configuration
# ==========================================

# --- General Application Settings ---
PROJECT_NAME="CogniLearn AI"
VERSION="0.1.0"
ENV="development"
LOG_LEVEL="INFO"

# --- Backend FastAPI Core ---
HOST="0.0.0.0"
PORT=8000

# --- PostgreSQL 17 + pgvector ---
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password_change_me"
POSTGRES_DB="cognilearn"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# --- Redis Rate Limiter & Caching ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"

# --- OpenTelemetry & Jaeger Distributed Tracing ---
OTEL_SERVICE_NAME="cognilearn-backend"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"

# --- OpenAI API Configuration ---
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"
DEFAULT_EMBEDDING_MODEL="text-embedding-3-small"
DEFAULT_COMPLETION_MODEL="gpt-4o-mini"

# --- Next.js 15 Frontend Settings ---
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"